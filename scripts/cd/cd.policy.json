{
  "steps": [
    { "percent": 10, "dwellMs": 40000 },
    { "percent": 25, "dwellMs": 40000 },
    { "percent": 50, "dwellMs": 40000 },
    { "percent": 75, "dwellMs": 40000 },
    { "percent": 100, "dwellMs": 40000 }
  ],
  "ingestWaitMs": 20000,
  "warmupMs": 0,
  "probe": {
    "rps": 25,
    "calls": [
      { "method": "GET", "path": "/", "auth": false },
      { "method": "GET", "path": "/v1/discover?remote=https%3A%2F%2F5ad2236b39de4c8bd8f6270ea63f3ea9.artifacts.cloudflare.net%2Fgit%2Fpublic-v0%2Fply.git", "auth": true }
    ]
  },
  "gates": {
    "smoke": "hard",
    "fivexx": "hard",
    "exceptions": "hard",
    "errorLogs": "hard",
    "nonOk": "hard",
    "burn": "hard",
    "latency": { "mode": "informational" }
  },
  "burn": {
    "fastBurn": 14.4,
    "minSamples": 100
  },
  "split": {
    "z": 3,
    "minNewRequests": 100,
    "onMismatch": "rollback",
    "onInsufficient": "hold"
  }
}
