{
  "name": "ply-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for ply: the /v1 git API and the public /view repository viewer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node src/smoke.mjs",
    "worker:deploy": "wrangler deploy",
    "test": "node --test test/worker.test.js && node --experimental-strip-types --import ./test/register-tsx.mjs --test test/viewer.test.ts",
    "test:worker": "node --test test/worker.test.js",
    "worker:test": "node --test test/worker.test.js",
    "test:viewer": "node --experimental-strip-types --import ./test/register-tsx.mjs --test test/viewer.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "hono": "^4.13.14",
    "ply": "github:ivarvong/ply#6091579f81a9abec0414ba79693aad5bb40eb0b9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.24.0",
    "oxlint": "^1.22.0",
    "typescript": "^7.0.2",
    "workerd": "1.20261018.1",
    "wrangler": "^4.152.0"
  },
  "license": "MIT",
  "author": "Ivar Vong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivarvong/ply-web.git"
  }
}
