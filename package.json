{
  "name": "ply-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for ply: the /v1 git API and the public /view repository viewer.",
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || >=26.12.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "types": "cf workers types",
    "smoke": "node src/smoke.mjs",
    "worker:deploy": "cf deploy",
    "worker:deploy:dry-run": "cf deploy --dry-run",
    "test": "node --test test/worker.test.js && node --experimental-strip-types --import ./test/register-tsx.mjs --test test/viewer.test.ts test/security.test.ts",
    "test:worker": "node --test test/worker.test.js",
    "worker:test": "node --test test/worker.test.js",
    "test:viewer": "node --experimental-strip-types --import ./test/register-tsx.mjs --test test/viewer.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && cf workers types && tsc --noEmit -p tsconfig.cloudflare.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "hono": "^4.13.14",
    "ply": "github:ivarvong/ply#d9e805f1bce4f0d86f0d8b4da658252541a286e0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.23",
    "esbuild": "^0.28.2",
    "oxlint": "^1.22.0",
    "parse5": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "workerd": "1.20261018.1"
  },
  "license": "MIT",
  "author": "Ivar Vong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivarvong/ply-web.git"
  }
}
